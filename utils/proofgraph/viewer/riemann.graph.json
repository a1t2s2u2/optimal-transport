{
  "_comment": "proofgraph viewer 用『リーマン予想の全体把握』マップ。viewer/?data=riemann.graph.json で開く。RH をハブに、ζ関数・零点・素数分布・同値命題・部分結果・一般化を関連づける。",
  "nodes": [
    {
      "id": "def:zeta",
      "env": "definition",
      "title": "リーマンゼータ関数 $\\zeta(s)$",
      "chapter": "ゼータ関数",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$\\zeta(s)=\\sum_{n=1}^{\\infty} n^{-s}$（$\\mathrm{Re}\\,s>1$ で収束）。",
      "has_proof": false,
      "is_axiomatic": true,
      "group": "ζ関数と零点"
    },
    {
      "id": "def:gamma",
      "env": "definition",
      "title": "ガンマ関数 $\\Gamma(s)$",
      "chapter": "ゼータ関数",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$\\Gamma(s)=\\int_0^{\\infty} t^{s-1}e^{-t}\\,\\d t$。関数等式に現れる。",
      "has_proof": false,
      "is_axiomatic": true,
      "group": "ζ関数と零点"
    },
    {
      "id": "thm:euler-product",
      "env": "theorem",
      "title": "オイラー積",
      "chapter": "ゼータ関数",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$\\zeta(s)=\\prod_{p\\,\\text{素数}}(1-p^{-s})^{-1}$。$\\zeta$ と素数を結ぶ等式。",
      "has_proof": true,
      "is_axiomatic": false,
      "group": "ζ関数と零点"
    },
    {
      "id": "thm:analytic-continuation",
      "env": "theorem",
      "title": "解析接続",
      "chapter": "ゼータ関数",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$\\zeta$ は $s=1$ の単純極を除き $\\mathbb{C}$ 全体へ一意に解析接続される。",
      "has_proof": true,
      "is_axiomatic": false,
      "group": "ζ関数と零点"
    },
    {
      "id": "thm:functional-equation",
      "env": "theorem",
      "title": "関数等式",
      "chapter": "ゼータ関数",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$\\zeta(s)$ と $\\zeta(1-s)$ を $\\Gamma$ と $\\pi$ で結ぶ対称関係 $\\xi(s)=\\xi(1-s)$。",
      "has_proof": true,
      "is_axiomatic": false,
      "group": "ζ関数と零点"
    },
    {
      "id": "def:critical-strip",
      "env": "definition",
      "title": "臨界帯",
      "chapter": "零点",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$0<\\mathrm{Re}\\,s<1$ の帯状領域。非自明零点はここに住む。",
      "has_proof": false,
      "is_axiomatic": true,
      "group": "ζ関数と零点"
    },
    {
      "id": "def:critical-line",
      "env": "definition",
      "title": "臨界線",
      "chapter": "零点",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$\\mathrm{Re}\\,s=\\tfrac12$ の直線。",
      "has_proof": false,
      "is_axiomatic": true,
      "group": "ζ関数と零点"
    },
    {
      "id": "thm:trivial-zeros",
      "env": "theorem",
      "title": "自明な零点",
      "chapter": "零点",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$s=-2,-4,-6,\\dots$ は $\\zeta$ の零点（関数等式から従う）。",
      "has_proof": true,
      "is_axiomatic": false,
      "group": "ζ関数と零点"
    },
    {
      "id": "def:nontrivial-zeros",
      "env": "definition",
      "title": "非自明零点",
      "chapter": "零点",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "臨界帯 $0<\\mathrm{Re}\\,s<1$ の中にある $\\zeta$ の零点。",
      "has_proof": false,
      "is_axiomatic": true,
      "group": "ζ関数と零点"
    },
    {
      "id": "clm:RH",
      "env": "claim",
      "title": "リーマン予想 (RH)",
      "chapter": "リーマン予想",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$\\zeta$ の\\textbf{非自明零点はすべて臨界線} $\\mathrm{Re}\\,s=\\tfrac12$ 上にある。",
      "has_proof": false,
      "is_axiomatic": false,
      "group": "リーマン予想"
    },
    {
      "id": "def:prime-counting",
      "env": "definition",
      "title": "素数計数関数 $\\pi(x)$",
      "chapter": "素数分布と同値命題",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$\\pi(x)=\\#\\{p\\le x: p\\ \\text{は素数}\\}$。",
      "has_proof": false,
      "is_axiomatic": true,
      "group": "素数と同値命題"
    },
    {
      "id": "def:li",
      "env": "definition",
      "title": "対数積分 $\\mathrm{Li}(x)$",
      "chapter": "素数分布と同値命題",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$\\mathrm{Li}(x)=\\int_2^x \\dfrac{\\d t}{\\ln t}$。$\\pi(x)$ のよい近似。",
      "has_proof": false,
      "is_axiomatic": true,
      "group": "素数と同値命題"
    },
    {
      "id": "def:mobius",
      "env": "definition",
      "title": "メビウス関数 $\\mu(n)$",
      "chapter": "素数分布と同値命題",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "平方因子を持つと $0$、相異なる $k$ 個の素因数で $(-1)^k$。",
      "has_proof": false,
      "is_axiomatic": true,
      "group": "素数と同値命題"
    },
    {
      "id": "def:mertens",
      "env": "definition",
      "title": "メルテンス関数 $M(x)$",
      "chapter": "素数分布と同値命題",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$M(x)=\\sum_{n\\le x}\\mu(n)$。",
      "has_proof": false,
      "is_axiomatic": true,
      "group": "素数と同値命題"
    },
    {
      "id": "thm:zero-free-1",
      "env": "theorem",
      "title": "零点自由領域 $\\mathrm{Re}\\,s=1$",
      "chapter": "素数分布と同値命題",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$\\zeta$ は直線 $\\mathrm{Re}\\,s=1$ 上に零点を持たない（素数定理の鍵）。",
      "has_proof": true,
      "is_axiomatic": false,
      "group": "素数と同値命題"
    },
    {
      "id": "thm:pnt",
      "env": "theorem",
      "title": "素数定理",
      "chapter": "素数分布と同値命題",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$\\pi(x)\\sim \\dfrac{x}{\\ln x}$。$\\mathrm{Re}\\,s=1$ 上の無零点性から従う。",
      "has_proof": true,
      "is_axiomatic": false,
      "group": "素数と同値命題"
    },
    {
      "id": "thm:explicit-formula",
      "env": "theorem",
      "title": "明示公式",
      "chapter": "素数分布と同値命題",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "$\\pi(x)$ を $\\zeta$ の非自明零点にわたる和で表す（Riemann--von Mangoldt）。",
      "has_proof": true,
      "is_axiomatic": false,
      "group": "素数と同値命題"
    },
    {
      "id": "clm:RH-error",
      "env": "claim",
      "title": "誤差項評価（RH と同値）",
      "chapter": "素数分布と同値命題",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "RH $\\iff$ $\\pi(x)=\\mathrm{Li}(x)+O(\\sqrt{x}\\,\\ln x)$。",
      "has_proof": false,
      "is_axiomatic": false,
      "group": "素数と同値命題"
    },
    {
      "id": "clm:RH-mertens",
      "env": "claim",
      "title": "メルテンス評価（RH と同値）",
      "chapter": "素数分布と同値命題",
      "section": "",
      "subsection": "",
      "source_file": "demo",
      "spaces": [],
      "statement": "RH $\\iff$ $M(x)=O(x^{1/2+\\varepsilon})$（任意の $\\varepsilon>0$）。",
      "has_proof": false,
      "is_axiomatic": false,
      "group": "素数と同値命題"
    },
    {
